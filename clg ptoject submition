SQL IMPLEMENTATION

5.1 Database Creation

```sql
CREATE DATABASE Online_Examination_System;
USE Online_Examination_System;
```

5.2 Table Creation Statements

5.2.1 Student Table

```sql
CREATE TABLE STUDENT (
    Student_ID INT PRIMARY KEY,
    Student_Name VARCHAR(50) NOT NULL,
    Email VARCHAR(100) UNIQUE NOT NULL,
    Phone VARCHAR(15) UNIQUE NOT NULL,
    Department VARCHAR(30) NOT NULL DEFAULT 'CSE',
    Year_Of_Study INT NOT NULL DEFAULT 2,
    CHECK (Year_Of_Study BETWEEN 1 AND 4)
);
```

5.2.2 Instructor Table

```sql
CREATE TABLE INSTRUCTOR (
    Instructor_ID INT PRIMARY KEY,
    Instructor_Name VARCHAR(50) NOT NULL,
    Email VARCHAR(100) UNIQUE NOT NULL,
    Department VARCHAR(30) NOT NULL,
    Specialization VARCHAR(50) NOT NULL
);
```

5.2.3 Course Table

```sql
CREATE TABLE COURSE (
    Course_ID INT PRIMARY KEY,
    Course_Name VARCHAR(100) UNIQUE NOT NULL,
    Credits INT NOT NULL DEFAULT 3,
    Department VARCHAR(30) NOT NULL,
    Instructor_ID INT,
    CHECK (Credits BETWEEN 1 AND 6),
    FOREIGN KEY (Instructor_ID) REFERENCES INSTRUCTOR(Instructor_ID)
);
```

5.2.4 Enrollment Table

```sql
CREATE TABLE ENROLLMENT (
    Student_ID INT NOT NULL,
    Course_ID INT NOT NULL,
    Enroll_Date DATE NOT NULL DEFAULT CURRENT_DATE,
    Status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE',
    PRIMARY KEY (Student_ID, Course_ID),
    CHECK (Status IN ('ACTIVE','INACTIVE','PENDING')),
    CHECK (Enroll_Date >= '2026-01-01'),
    FOREIGN KEY (Student_ID) REFERENCES STUDENT(Student_ID) ON DELETE CASCADE,
    FOREIGN KEY (Course_ID) REFERENCES COURSE(Course_ID) ON DELETE CASCADE
);
```

5.2.5 Exam Table

```sql
CREATE TABLE EXAM (
    Exam_ID INT PRIMARY KEY,
    Exam_Title VARCHAR(100) NOT NULL,
    Course_ID INT NOT NULL,
    Exam_Date DATE NOT NULL,
    Duration_Minutes INT NOT NULL DEFAULT 60,
    Total_Marks INT NOT NULL DEFAULT 100,
    Exam_Type VARCHAR(20) NOT NULL,
    CHECK (Duration_Minutes BETWEEN 10 AND 240),
    CHECK (Total_Marks BETWEEN 1 AND 200),
    CHECK (Exam_Type IN ('QUIZ','MIDTERM','FINAL')),
    CHECK (Exam_Date >= '2026-01-01'),
    FOREIGN KEY (Course_ID) REFERENCES COURSE(Course_ID)
);
```

5.2.6 Question Table

```sql
CREATE TABLE QUESTION (
    Exam_ID INT NOT NULL,
    Question_No SMALLINT NOT NULL,
    Question_Text VARCHAR(200) NOT NULL,
    Question_Type VARCHAR(15) NOT NULL DEFAULT 'MCQ',
    Marks SMALLINT NOT NULL DEFAULT 1,
    PRIMARY KEY (Exam_ID, Question_No),
    CHECK (Question_No > 0),
    CHECK (Marks > 0),
    CHECK (Question_Type IN ('MCQ','TRUE/FALSE','FILL IN THE BLANK')),
    FOREIGN KEY (Exam_ID) REFERENCES EXAM(Exam_ID) ON DELETE CASCADE
);
```

5.2.7 Question_Option Table

```sql
CREATE TABLE QUESTION_OPTION (
    Exam_ID INT NOT NULL,
    Question_No SMALLINT NOT NULL,
    Option_Label CHAR(1) NOT NULL,
    Option_Text VARCHAR(200) NOT NULL,
    Is_Correct CHAR(3) NOT NULL DEFAULT 'NO',
    PRIMARY KEY (Exam_ID, Question_No, Option_Label),
    CHECK (Option_Label IN ('A','B','C','D')),
    CHECK (Is_Correct IN ('YES','NO')),
    FOREIGN KEY (Exam_ID, Question_No) REFERENCES QUESTION(Exam_ID, Question_No)
    ON DELETE CASCADE
);
```

5.2.8 Exam_Attempt Table

```sql
CREATE TABLE EXAM_ATTEMPT (
    Attempt_ID INT PRIMARY KEY,
    Student_ID INT NOT NULL,
    Exam_ID INT NOT NULL,
    Attempt_Date DATE NOT NULL,
    Status VARCHAR(20) NOT NULL DEFAULT 'IN PROGRESS',
    Marks_Obtained DECIMAL(5,2) NOT NULL DEFAULT 0,
    UNIQUE (Student_ID, Exam_ID),
    CHECK (Status IN ('IN PROGRESS','COMPLETED')),
    CHECK (Marks_Obtained >= 0),
    FOREIGN KEY (Student_ID) REFERENCES STUDENT(Student_ID),
    FOREIGN KEY (Exam_ID) REFERENCES EXAM(Exam_ID)
);
```

5.2.9 Answer Table

```sql
CREATE TABLE ANSWER (
    Attempt_ID INT NOT NULL,
    Exam_ID INT NOT NULL,
    Question_No SMALLINT NOT NULL,
    Selected_Label CHAR(1) NOT NULL,
    Is_Correct CHAR(3) NOT NULL,
    Marks_Scored DECIMAL(5,2) NOT NULL DEFAULT 0,
    PRIMARY KEY (Attempt_ID, Exam_ID, Question_No),
    CHECK (Selected_Label IN ('A','B','C','D')),
    CHECK (Is_Correct IN ('YES','NO')),
    CHECK (Marks_Scored >= 0),
    FOREIGN KEY (Attempt_ID) REFERENCES EXAM_ATTEMPT(Attempt_ID),
    FOREIGN KEY (Exam_ID, Question_No) REFERENCES QUESTION(Exam_ID, Question_No)
);
```

5.2.10 Result Table

```sql
CREATE TABLE RESULT (
    Result_ID INT PRIMARY KEY,
    Attempt_ID INT UNIQUE NOT NULL,
    Percentage DECIMAL(5,2) NOT NULL,
    Grade CHAR(1) NOT NULL DEFAULT 'F',
    Status VARCHAR(10) NOT NULL DEFAULT 'FAIL',
    Published_Date DATE NOT NULL,
    CHECK (Percentage BETWEEN 0 AND 100),
    CHECK (Grade IN ('A','B','C','D','F')),
    CHECK (Status IN ('PASS','FAIL')),
    FOREIGN KEY (Attempt_ID) REFERENCES EXAM_ATTEMPT(Attempt_ID)
);
```

